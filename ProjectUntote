-- Function to find NPCs in workspace
local function findNPCs()
    if not _G.NPCEnabled then return {} end
    
    local npcs = {}
    
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
            local isPlayer = false
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character == model then
                    isPlayer = true
                    break
                end
            end
            
            if not isPlayer then
                local humanoid = model:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    if not TrackedNPCs[model] then
                        table.insert(npcs, model)
                        TrackedNPCs[model] = true
                    end
                else
                    TrackedNPCs[model] = nil
                    removeNPCESP(model)
                end
            end
        end
    end
    
    return npcs
end

-- Main hitbox adjustment function for NPCs only
local function adjustNPCHitbox(character, headSize)
    pcall(function()
        local head = character:FindFirstChild("Head")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if head and humanoid then
            if humanoid.Health > 0 then
                -- Adjust hitbox when alive
                head.Size = Vector3.new(headSize, headSize, headSize)
                head.Transparency = 0.5
                head.BrickColor = BrickColor.new("Bright orange")
                head.Material = Enum.Material.Neon
                head.CanCollide = false
                head.Massless = true
            else
                -- Hide hitbox when dead
                head.Transparency = 1
                head.CanTouch = false
                head.CanQuery = false
                TrackedNPCs[character] = nil
                removeNPCESP(character)
            end
        end
    end)
end

-- Main loops
RunService.RenderStepped:Connect(function()
    if not _G.Disabled then
        -- Process NPCs
        if _G.NPCEnabled then
            local npcs = findNPCs()
            for _, npc in ipairs(npcs) do
                adjustNPCHitbox(npc, _G.NPCHeadSize)
            end
        end
        
        -- Update NPC ESP
        updateNPCESP()
        
        -- Clean up NPC tracking for removed NPCs
        for character, _ in pairs(TrackedNPCs) do
            if not character.Parent then
                TrackedNPCs[character] = nil
                removeNPCESP(character)
            else
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if not humanoid or humanoid.Health <= 0 then
                    TrackedNPCs[character] = nil
                    removeNPCESP(character)
                end
            end
        end
    else
        -- Reset NPC hitboxes when disabled
        for character, _ in pairs(TrackedNPCs) do
            if character and character.Parent then
                local head = character:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(2, 1, 1)
                    head.Transparency = 0
                    head.BrickColor = BrickColor.new("Medium stone grey")
                    head.Material = Enum.Material.Plastic
                    head.CanCollide = true
                    head.Massless = false
                end
            end
            TrackedNPCs[character] = nil
            removeNPCESP(character)
        end
    end
end)

