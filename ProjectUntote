local function removeNPCESP(npc)
    if NPCESPInstances[npc] then
        NPCESPInstances[npc]:Destroy()
        NPCESPInstances[npc] = nil
    end
end

local function updateNPCESP()
    if not _G.ESPEnabled then return end
    
    for npc, _ in pairs(TrackedNPCs) do
        if npc and npc.Parent then
            local humanoid = npc:FindFirstChildOfClass("Humanoid")
            local rootPart = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChild("Torso") or npc:FindFirstChild("UpperTorso")
            
            if humanoid and rootPart and humanoid.Health > 0 then
                if not NPCESPInstances[npc] then
                    createNPCESP(npc)
                end
                
                local esp = NPCESPInstances[npc]
                if esp then
                    local position, onScreen = Camera:WorldToViewportPoint(rootPart.Position)
                    
                    if onScreen then
                        -- Calculate box size
                        local head = npc:FindFirstChild("Head")
                        local boxSize = Vector2.new(60, 100)
                        
                        if head then
                            local headPos = Camera:WorldToViewportPoint(head.Position)
                            local rootPos = Camera:WorldToViewportPoint(rootPart.Position)
                            boxSize = Vector2.new(
                                math.max(40, math.abs(headPos.X - rootPos.X) * 3),
                                math.max(80, math.abs(headPos.Y - rootPos.Y) * 5)
                            )
                        end
                        
                        -- Update ESP elements
                        local nameTag = esp:FindFirstChild("NameTag")
                        local distanceTag = esp:FindFirstChild("DistanceTag")
                        local healthBarBG = esp:FindFirstChild("HealthBarBG")
                        local healthBar = healthBarBG and healthBarBG:FindFirstChild("HealthBar")
                        local box = esp:FindFirstChild("Box")
                        
                        if nameTag then
                            nameTag.Position = UDim2.new(0, position.X - 50, 0, position.Y - 80)
                            nameTag.Visible = true
                        end
                        
                        if distanceTag then
                            local distance = (rootPart.Position - Camera.CFrame.Position).Magnitude
                            distanceTag.Text = string.format("%.0f studs", distance)
                            distanceTag.Position = UDim2.new(0, position.X - 50, 0, position.Y - 60)
                            distanceTag.Visible = true
                        end
                        
                        if healthBar and humanoid then
                            local healthPercent = humanoid.Health / humanoid.MaxHealth
                            healthPercent = math.clamp(healthPercent, 0, 1)
                            healthBar.Size = UDim2.new(healthPercent, 0, 1, 0)
                            healthBar.BackgroundColor3 = Color3.fromRGB(
                                255 * (1 - healthPercent),
                                255 * healthPercent,
                                0
                            )
                            if healthBarBG then
                                healthBarBG.Position = UDim2.new(0, position.X - 50, 0, position.Y - 40)
                                healthBarBG.Visible = true
                            end
                        end
                        
                        if box then
                            box.Position = UDim2.new(0, position.X - boxSize.X/2, 0, position.Y - boxSize.Y/2)
                            box.Size = UDim2.new(0, boxSize.X, 0, boxSize.Y)
                            box.Visible = true
                        end
                    else
                        -- Hide ESP if off-screen
                        for _, child in pairs(esp:GetChildren()) do
                            child.Visible = false
                        end
                    end
                end
            else
                removeNPCESP(npc)
            end
        else
            removeNPCESP(npc)
        end
    end
end

local function toggleESP(enabled)
    _G.ESPEnabled = enabled
    
    if not enabled then
        -- Remove all ESP instances
        for npc, esp in pairs(NPCESPInstances) do
            esp:Destroy()
        end
        NPCESPInstances = {}
    end
end

-- INSTANT INTERACT FIXED VERSION - Keep prompts normal but trigger instantly
local instantInteractConnections = {}
local activePrompts = {}

local function onPromptButtonHoldBegan(prompt)
    if not _G.InstantInteractEnabled then return end
    
    -- Store the original hold duration
    local originalHoldDuration = prompt.HoldDuration
    
    -- DON'T modify the prompt - keep it looking normal
    -- Just trigger it immediately
    fireproximityprompt(prompt)
    
    -- For long prompts, also simulate holding for the required time
    -- This helps with server-side checks
    if originalHoldDuration > 0.5 then
        local promptId = tostring(prompt)
        
        -- Clear any existing task for this prompt
        if activePrompts[promptId] then
            activePrompts[promptId]:Disconnect()
        end
        
        -- Create a new task to keep firing the prompt
        local connection = RunService.Heartbeat:Connect(function()
            if prompt and prompt.Parent then
                fireproximityprompt(prompt)
            else
                connection:Disconnect()
                activePrompts[promptId] = nil
            end
        end)
        
        activePrompts[promptId] = connection
        
        -- Stop after the original hold duration
        task.delay(originalHoldDuration, function()
            if connection then
                connection:Disconnect()
            end
            activePrompts[promptId] = nil
        end)
    end
end

local function onPromptShown(prompt)
    if not _G.InstantInteractEnabled then return end
    
    -- Don't modify the prompt properties - keep it looking normal
    -- Only increase range slightly for convenience
    prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 25)
    
    -- Don't auto-trigger by default - let the user press the button
    -- The button press will trigger instantly
end

local function toggleInstantInteract(enabled)
    _G.InstantInteractEnabled = enabled
    
    if enabled then
        print("Instant Interact Enabled")
        print("Prompts will appear normal but trigger instantly when you press the button")
        
        -- Make existing prompts have better range
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                obj.MaxActivationDistance = math.max(obj.MaxActivationDistance, 25)
            end
        end
        
        -- Connect to prompt events
        local promptShown = ProximityPromptService.PromptShown:Connect(onPromptShown)
        local promptBegan = ProximityPromptService.PromptButtonHoldBegan:Connect(onPromptButtonHoldBegan)
        
        -- Make new prompts have better range
        local descendantAdded = workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ProximityPrompt") then
                obj.MaxActivationDistance = math.max(obj.MaxActivationDistance, 25)
            end
        end)
        
        table.insert(instantInteractConnections, promptShown)
        table.insert(instantInteractConnections, promptBegan)
        table.insert(instantInteractConnections, descendantAdded)
        
        print("Ready! Press your interact button (usually E) near prompts to instantly trigger them")
        
    else
        -- Disconnect all connections
        for _, connection in ipairs(instantInteractConnections) do
            connection:Disconnect()
        end
        instantInteractConnections = {}
        
        -- Stop all active prompt tasks
        for promptId, connection in pairs(activePrompts) do
            if connection then
                connection:Disconnect()
            end
        end
        activePrompts = {}
        
        print("Instant Interact Disabled")
    end
end

