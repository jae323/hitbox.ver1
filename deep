-- Aimbot functions (createFOVCircle, isWallCheckPassed, smoothAim, getClosestTargetInFOV) ...
-- (same as previous, just using deltaTime for smoothAim)

local function adjustHitbox(character, size, isNPC, player)
    pcall(function()
        local head = character:FindFirstChild("Head")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if head and humanoid then
            if humanoid.Health > 0 then
                head.Size = Vector3.new(size, size, size)
                head.Transparency = 0.5
                head.BrickColor = isNPC and BrickColor.new("Bright orange") or BrickColor.new("Bright red")
                head.Material = Enum.Material.Neon
                head.CanCollide = false
                head.Massless = true
                if _G.ESPEnabled then
                    local esp = isNPC and (ESPBoxes[character] or createNPCESPBox(character)) or (PlayerESPBoxes[character] or createPlayerESPBox(character, player))
                    if esp then updateESP(character, esp) end
                end
            else
                -- Instant removal on death
                head.Transparency = 1
                head.CanTouch = false
                head.CanQuery = false
                local esp = isNPC and ESPBoxes[character] or PlayerESPBoxes[character]
                if esp then
                    if esp.Highlight then esp.Highlight:Destroy() end
                    if esp.Billboard then esp.Billboard:Destroy() end
                    if isNPC then ESPBoxes[character] = nil else PlayerESPBoxes[character] = nil end
                end
            end
        end
    end)
end

-- Main loop with NPC refresh timer
RunService.RenderStepped:Connect(function(deltaTime)
    local dt = math.min(deltaTime, 0.1)
    lastRenderTime = tick()

    -- Continuous NPC refresh every 1 second (even without aimbot)
    if _G.NPCEnabled and (tick() - lastNPCRefresh) > 1.0 then
        updateNPCCache()
        lastNPCRefresh = tick()
    end

    if not _G.Disabled then
        -- Process players (as before)
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                local char = player.Character
                if shouldApplyHitbox(player) then
                    adjustHitbox(char, _G.PlayerHeadSize, false, player)
                else
                    -- Reset teammate
                    local head = char:FindFirstChild("Head")
                    if head then
                        head.Size = Vector3.new(2,1,1)
                        head.Transparency = 0
                        head.BrickColor = BrickColor.new("Medium stone grey")
                        head.Material = Enum.Material.Plastic
                        head.CanCollide = true; head.Massless = false
                    end
                    if PlayerESPBoxes[char] then
                        local esp = PlayerESPBoxes[char]
                        if esp.Highlight then esp.Highlight:Destroy() end
                        if esp.Billboard then esp.Billboard:Destroy() end
                        PlayerESPBoxes[char] = nil
                    end
                end
            end
        end

        -- Process NPCs from the now‑fresh NPCsCache
        if _G.NPCEnabled then
            for _, npcData in ipairs(NPCsCache) do
                if npcData.Model and npcData.Model.Parent then
                    adjustHitbox(npcData.Model, _G.NPCHeadSize, true, nil)
                end
            end
        end

        -- Cleanup dead (still needed for cases where parent is removed)
        for char, esp in pairs(ESPBoxes) do
            if not char.Parent then
                if esp.Highlight then esp.Highlight:Destroy() end
                if esp.Billboard then esp.Billboard:Destroy() end
                ESPBoxes[char] = nil
            end
        end
        for char, esp in pairs(PlayerESPBoxes) do
            if not char.Parent then
                if esp.Highlight then esp.Highlight:Destroy() end
                if esp.Billboard then esp.Billboard:Destroy() end
                PlayerESPBoxes[char] = nil
            end
        end
    else
        -- Disabled: reset all
        for _, player in ipairs(Players:GetPlayers()) do
            local char = player.Character
            if char then
                local head = char:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(2,1,1)
                    head.Transparency = 0
                    head.BrickColor = BrickColor.new("Medium stone grey")
                    head.Material = Enum.Material.Plastic
                    head.CanCollide = true; head.Massless = false
                end
            end
        end
        for _, esp in pairs(ESPBoxes) do
            if esp.Highlight then esp.Highlight:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        for _, esp in pairs(PlayerESPBoxes) do
            if esp.Highlight then esp.Highlight:Destroy() end
            if esp.Billboard then esp.Billboard:Destroy() end
        end
        ESPBoxes = {}; PlayerESPBoxes = {}
    end

    -- Aimbot
    if _G.AimbotEnabled then
        if FOVCircle then
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            FOVCircle.Radius = _G.AimbotFOV
            FOVCircle.Visible = true
        end
        local target, part, pos, velocity = getClosestTargetInFOV()
        if pos then
            local aimPos = pos
            if _G.AimbotPrediction and velocity then
                local predictionTime = _G.AimbotPredictionFactor * (pos - Camera.CFrame.Position).Magnitude / math.max(velocity.Magnitude, 1)
                aimPos = pos + velocity * predictionTime
            end
            Camera.CFrame = smoothAim(Camera.CFrame, aimPos, _G.AimbotSmoothness, dt)
        end
    elseif FOVCircle then
        FOVCircle.Visible = false
    end
end)

