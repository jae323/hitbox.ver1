    Instance.new("UICorner", headButton).CornerRadius = UDim.new(0, 6)
    
    -- Torso Button
    local torsoButton = Instance.new("TextButton")
    torsoButton.Size = UDim2.new(0.48, 0, 1, 0)
    torsoButton.Position = UDim2.new(0.52, 0, 0, 0)
    torsoButton.BackgroundColor3 = (default == "HumanoidRootPart") and Colors.Primary or Colors.Surface
    torsoButton.Text = "TORSO"
    torsoButton.TextColor3 = Colors.Text
    torsoButton.Font = Enum.Font.GothamBold
    torsoButton.TextSize = 13
    torsoButton.Parent = buttonFrame
    Instance.new("UICorner", torsoButton).CornerRadius = UDim.new(0, 6)
    
    local current = default
    local function updateSelection()
        headButton.BackgroundColor3 = (current == "Head") and Colors.Primary or Colors.Surface
        torsoButton.BackgroundColor3 = (current == "HumanoidRootPart") and Colors.Primary or Colors.Surface
    end
    updateSelection()
    
    headButton.MouseButton1Click:Connect(function()
        current = "Head"
        updateSelection()
