-- ==========================================
-- IMPROVED NPC DETECTION with continuous refresh
-- ==========================================
local function findAllNPCs()
    if not _G.NPCEnabled then return {} end
    local npcs = {}
    local workspaceDescendants = workspace:GetDescendants()
    for _, instance in ipairs(workspaceDescendants) do
        if instance:IsA("Humanoid") and instance.Health > 0 then
            local model = instance.Parent
            if model and (model:IsA("Model") or model:IsA("Folder")) then
                local isPlayer = false
                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr.Character and (plr.Character == model or plr.Character:FindFirstChildOfClass("Humanoid") == instance) then
                        isPlayer = true
                        break
                    end
                end
                if not isPlayer and not TrackedNPCs[instance] then
                    table.insert(npcs, {Model = model, Humanoid = instance})
                    TrackedNPCs[instance] = true
                end
            end
        end
    end
    -- Clean up dead entries
    for humanoid, _ in pairs(TrackedNPCs) do
        if not humanoid or humanoid.Health <= 0 or not humanoid.Parent then
            TrackedNPCs[humanoid] = nil
        end
    end
    return npcs
end

local function updateNPCCache()
    NPCsCache = {}
    local raw = findAllNPCs()
    for _, npc in ipairs(raw) do
        table.insert(NPCsCache, npc)
    end
    LastCacheUpdate = tick()
end

-- Aimbot target list (still uses 0.5s refresh)
local function getAimbotTargets()
    local targets = {}
    local now = tick()
    if now - LastCacheUpdate > 0.5 then
        updateNPCCache()
    end
    for _, npcData in ipairs(NPCsCache) do
        if npcData.Model and npcData.Model.Parent and npcData.Humanoid and npcData.Humanoid.Health > 0 then
            table.insert(targets, {Model = npcData.Model, IsNPC = true})
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.Health > 0 then
                if not _G.AimbotTeamCheck or (_G.AimbotTeamCheck and isAimbotEnemy(player)) then
                    table.insert(targets, {Model = player.Character, IsNPC = false, Player = player})
                end
            end
        end
    end
    return targets
end

-- Helper functions (isEnemy, shouldApplyHitbox, etc.) remain the same as previous answer.
-- I'll include them briefly for completeness.

local function isEnemy(player)
    if not _G.TeamCheck then return true end
    if not LocalPlayer.Team or not player.Team then return true end
    return LocalPlayer.Team ~= player.Team
end
local function isAimbotEnemy(player)
    if not _G.AimbotTeamCheck then return true end
    if not LocalPlayer.Team or not player.Team then return true end
    return LocalPlayer.Team ~= player.Team
end
local function shouldApplyHitbox(player)
    if _G.Disabled then return false end
    if not _G.TeamCheck then return true end
    if isEnemy(player) then return true end
    return _G.TeamHitbox
end

