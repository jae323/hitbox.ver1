-- Function to check if a player is an enemy
local function isEnemy(player)
    if not _G.TeamCheck then return true end
    if not LocalPlayer.Team or not player.Team then return true end
    return LocalPlayer.Team ~= player.Team
end

-- ESP Functions
local function createESPBox(character, isNPC)
    if not character or not character:FindFirstChild("Head") then return nil end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = character
    highlight.FillColor = _G.ESPColor
    highlight.FillTransparency = _G.ESPTransparency
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    if _G.ShowName then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP_Billboard"
        billboard.Adornee = character:WaitForChild("Head")
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.Text = isNPC and "NPC" or character.Name
        nameLabel.TextColor3 = _G.ESPColor
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextSize = 14
        nameLabel.Parent = billboard
        
        if _G.ShowDistance or _G.ShowHealth then
            local infoLabel = Instance.new("TextLabel")
            infoLabel.Size = UDim2.new(1, 0, 0.5, 0)
            infoLabel.Position = UDim2.new(0, 0, 0.5, 0)
            infoLabel.BackgroundTransparency = 1
            infoLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
            infoLabel.Font = Enum.Font.Gotham
            infoLabel.TextSize = 12
            infoLabel.Parent = billboard
            
            ESPBoxes[character] = {
                Highlight = highlight,
                Billboard = billboard,
                InfoLabel = infoLabel,
                IsNPC = isNPC
            }
        else
            ESPBoxes[character] = {
                Highlight = highlight,
                Billboard = billboard,
                IsNPC = isNPC
            }
        end
        
        billboard.Parent = character
    else
        ESPBoxes[character] = {
            Highlight = highlight,
            IsNPC = isNPC
        }
    end
    
    return ESPBoxes[character]
end

local function updateESP(character, espData)
    if not character or not espData then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    -- Remove ESP if player is dead or NPC is dead
    if humanoid.Health <= 0 then
        if espData.Highlight then espData.Highlight:Destroy() end
        if espData.Billboard then espData.Billboard:Destroy() end
        ESPBoxes[character] = nil
        return
    end
    
    -- Update distance and health info
    if espData.InfoLabel then
        local infoText = ""
        
        if _G.ShowDistance then
            local distance = (character:GetPivot().Position - Camera.CFrame.Position).Magnitude
            if distance <= _G.MaxDistance then
                infoText = string.format("Dist: %d", math.floor(distance))
            end
        end
        
        if _G.ShowHealth then
            if infoText ~= "" then
                infoText = infoText .. " | "
            end
            infoText = infoText .. string.format("HP: %d/%d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
        end
        
        espData.InfoLabel.Text = infoText
    end
    
    -- Update ESP color based on team
    if not espData.IsNPC then
        local player = Players:GetPlayerFromCharacter(character)
        if player and player.Team then
            espData.Highlight.FillColor = isEnemy(player) and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 150, 255)
        end
    end
end

-- Function to find NPCs in workspace
local function findNPCs()
    if not _G.NPCEnabled then return {} end
    
    local npcs = {}
    
    -- Look for models with Humanoid that aren't player characters
    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and model:FindFirstChildOfClass("Humanoid") then
            local isPlayer = false
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character == model then
                    isPlayer = true
                    break
                end
            end
            
            if not isPlayer and not TrackedNPCs[model] then
                table.insert(npcs, model)
                TrackedNPCs[model] = true
            end
        end
    end
    
    return npcs
end

-- Main hitbox adjustment function
local function adjustHitbox(character, headSize, isNPC)
    pcall(function()
        local head = character:FindFirstChild("Head")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if head and humanoid then
            if humanoid.Health > 0 then
                -- Adjust hitbox when alive
                head.Size = Vector3.new(headSize, headSize, headSize)
                head.Transparency = 0.5
                head.BrickColor = isNPC and BrickColor.new("Bright orange") or BrickColor.new("Bright red")
                head.Material = Enum.Material.Neon
                head.CanCollide = false
                head.Massless = true
                
                -- Create/update ESP if enabled
                if _G.ESPEnabled then
                    local espData = ESPBoxes[character] or createESPBox(character, isNPC)
                    if espData then
                        updateESP(character, espData)
                    end
                end
            else
                -- Hide hitbox when dead
                head.Transparency = 1
                head.CanTouch = false
                head.CanQuery = false
                
                -- Remove ESP when dead
                local espData = ESPBoxes[character]
                if espData then
                    if espData.Highlight then espData.Highlight:Destroy() end
                    if espData.Billboard then espData.Billboard:Destroy() end
                    ESPBoxes[character] = nil
                end
            end
        end
    end)
end

-- Main loop for hitbox adjustment
RunService.RenderStepped:Connect(function()
    if not _G.Disabled then
        -- Process players
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                if character then
                    if _G.TeamCheck and not isEnemy(player) then
                        -- Reset teammate hitbox
                        local head = character:FindFirstChild("Head")
                        if head then
                            head.Size = Vector3.new(2, 1, 1)
                            head.Transparency = 0
                            head.BrickColor = BrickColor.new("Medium stone grey")
                            head.Material = Enum.Material.Plastic
                            head.CanCollide = true
                            head.Massless = false
                        end
                    else
                        adjustHitbox(character, _G.PlayerHeadSize, false)
                    end
                end
            end
        end
        
        -- Process NPCs
        if _G.NPCEnabled then
            local npcs = findNPCs()
            for _, npc in ipairs(npcs) do
                adjustHitbox(npc, _G.NPCHeadSize, true)
            end
        end
        
        -- Clean up dead ESP boxes
        for character, espData in pairs(ESPBoxes) do
            if not character.Parent then
                if espData.Highlight then espData.Highlight:Destroy() end
                if espData.Billboard then espData.Billboard:Destroy() end
                ESPBoxes[character] = nil
            elseif espData.IsNPC then
                TrackedNPCs[character] = nil
            end
        end
    else
        -- Reset all hitboxes when disabled
        for _, player in ipairs(Players:GetPlayers()) do
            local character = player.Character
            if character then
                local head = character:FindFirstChild("Head")
                if head then
                    head.Size = Vector3.new(2, 1, 1)
                    head.Transparency = 0
                    head.BrickColor = BrickColor.new("Medium stone grey")
                    head.Material = Enum.Material.Plastic
                    head.CanCollide = true
                    head.Massless = false
                end
            end
        end
        
        -- Remove all ESP
        for character, espData in pairs(ESPBoxes) do
            if espData.Highlight then espData.Highlight:Destroy() end
            if espData.Billboard then espData.Billboard:Destroy() end
            ESPBoxes[character] = nil
        end
    end
end)

-- Raycast function for aimbot detection (optional integration)
function RaycastForHitbox(origin, direction, length, ignoreList)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterDescendantsInstances = ignoreList
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.IgnoreWater = true

    local ray = workspace:Raycast(origin, direction * length, raycastParams)
    if ray then
        local hit = ray.Instance
        if hit and hit:IsA("BasePart") then
            local character = hit.Parent
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local head = character:FindFirstChild("Head")
            
            if humanoid and head and hit == head and humanoid.Health > 0 then
                print("Hit detected on:", character.Name)
                return character
            end
        end
    end
    return nil
end

